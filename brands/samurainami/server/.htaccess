# Protect SQLite database and journal/WAL files from direct HTTP download
<FilesMatch "\.(sqlite|sqlite3|db)(-(journal|wal|shm))?$">
  Require all denied
</FilesMatch>

# Route https://loop.samurainami.com/?s=<code> to s.php while keeping index.html untouched
RewriteEngine On
RewriteCond %{QUERY_STRING} ^s=([a-zA-Z0-9]{4,16})$
RewriteRule ^$ /s.php?s=%1 [L]
